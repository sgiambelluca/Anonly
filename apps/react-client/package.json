{
  "name": "@anonly/react-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cliente web de Anonly (React + Vite + Tailwind + Radix + Zustand).",
  "scripts": {
    "predev": "tsx scripts/copy-pdfjs-assets.ts",
    "dev": "vite",
    "prebuild": "tsx scripts/copy-pdfjs-assets.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run src/__tests__"
  },
  "dependencies": {
    "@anonly/anonymization-core": "workspace:*",
    "@anonly/export-engine": "workspace:*",
    "@anonly/ner-engine": "workspace:*",
    "@anonly/ocr-engine": "workspace:*",
    "@anonly/pdf-engine": "workspace:*",
    "@anonly/render-engine": "workspace:*",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "lucide-react": "^0.451.0",
    "pdfjs-dist": "^4.0.379",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
