+  /** Medición temporal: calienta el mismo slot/pool con un payload vacío. */
+  async preloadModel(ctx: EngineContext): Promise<void> {
+    if (!ctx.config.ner.enabled || ctx.abortSignal.aborted) return;
+    const payload: NerPagePayload = {
+      documentId: "__ner-preload__",
+      pageIndex: 0,
+      text: "",
+      modelId: ctx.config.ner.modelId,
+      quantization: ctx.config.ner.quantization,
+      ...(ctx.config.ner.wasmPaths !== undefined ? { wasmPaths: ctx.config.ner.wasmPaths } : {}),
+    };
+    await this.pool.dispatch({
+      run: async () => {
+        await (await loadNerKernel()).kernelClassify(payload, {
+          timeoutMs: ctx.config.workerPool.timeouts["ner-page"] ?? DEFAULT_TIMEOUT_MS,
+          abortSignal: ctx.abortSignal,
+          onProgress: () => undefined,
+        });
+        return [];
+      },
+      signal: ctx.abortSignal,
+      priority: DISPATCH_PRIORITY,
+      payload,
+      maxRetriesOverride: 0,
+      onProgress: () => undefined,
+    });
+    this.modelWarm = true;
+  }
+
   getModelId(): string {
     return this.modelId ?? DEFAULT_MODEL_ID;
   }
