{
  "name": "@anonly/ner-engine",
  "version": "0.0.0",
  "description": "NER Engine — Detecta personas, organizaciones, direcciones y fechas mediante un modelo NER local (Transformers.js + ONNX Runtime Web). Emite Occurrence[] con source: \"ner\".",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src/__tests__"
  },
  "dependencies": {
    "@anonly/shared": "workspace:*",
    "@xenova/transformers": "^2.17.2",
    "onnxruntime-web": "^1.14.0"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
