{
  "name": "@anonly/grouping-engine",
  "version": "0.9.0",
  "description": "Grouping Engine — Agrupa Occurrence (Regex/NER) en EntityGroup por tipo y valor canonico, detecta conflictos y resuelve replacementMode/replacementValue via Rule[].",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src/__tests__"
  },
  "dependencies": {
    "@anonly/shared": "workspace:*"
  },
  "devDependencies": {
    "@anonly/event-system": "workspace:*",
    "@anonly/test-utils": "workspace:*",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
