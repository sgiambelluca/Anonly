{
  "name": "@anonly/anonymization-core",
  "version": "0.9.2",
  "description": "API pública del Core de Anonly. Compone shared + event-system + motores. Los motores individuales se agregan en hitos 2-8.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src/__tests__"
  },
  "dependencies": {
    "@anonly/shared": "workspace:*",
    "@anonly/event-system": "workspace:*",
    "@anonly/pdf-engine": "workspace:*",
    "@anonly/ocr-engine": "workspace:*",
    "@anonly/regex-engine": "workspace:*",
    "@anonly/ner-engine": "workspace:*",
    "@anonly/grouping-engine": "workspace:*",
    "@anonly/render-engine": "workspace:*",
    "@anonly/export-engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
