{
  "name": "@anonly/export-engine",
  "version": "0.0.0",
  "description": "Export Engine — Construye el PDF final reconstruido desde cero, adjuntando las imágenes renderizadas (lado anonimizado) como páginas con pdf-lib. Garantiza no-recuperabilidad y metadata mínima.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./worker": {
      "types": "./src/worker/entry.ts",
      "import": "./src/worker/entry.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./worker": {
        "types": "./dist/worker/entry.d.ts",
        "import": "./dist/worker/entry.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src/__tests__"
  },
  "dependencies": {
    "@anonly/shared": "workspace:*",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@anonly/event-system": "workspace:*",
    "@anonly/test-utils": "workspace:*",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
