{
  "name": "@anonly/render-engine",
  "version": "0.0.0",
  "description": "Render Engine — Renderiza páginas del PDF (original o anonimizado) a ImageData usando OffscreenCanvas + pdfjs-dist. Aplica los 4 modos de reemplazo visual y soporta preview incremental / delta render.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src/__tests__"
  },
  "dependencies": {
    "@anonly/shared": "workspace:*",
    "pdfjs-dist": "^4.0.379"
  },
  "devDependencies": {
    "@anonly/event-system": "workspace:*",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
