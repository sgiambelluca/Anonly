{
  "name": "anonly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de anonimización documental 100% local. Ver docs/00_Project_Vision.md.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @anonly/react-client dev",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p tests/tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "build": "pnpm -r --filter \"./packages/anonymization-core/**\" run build",
    "build:clean": "pnpm -r exec rm -rf dist && pnpm build",
    "fixtures:generate": "tsx tests/fixtures/generate.ts",
    "assets:mirror": "tsx scripts/mirror-assets.ts",
    "lexicon:build": "tsx scripts/build-gender-lexicon.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run contract.test.ts",
    "test:snapshot": "vitest run snapshot.test.ts",
    "test:ui": "vitest run --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:perf": "vitest run tests/perf",
    "test:stress": "vitest run tests/stress",
    "test:leak": "vitest run tests/leak",
    "test:cancel": "vitest run tests/cancel",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.11.0",
    "@huggingface/transformers": "^4.2.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.16.10",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379",
    "prettier": "^3.3.3",
    "tesseract.js": "^6.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3",
      "esbuild": "^0.25.0",
      "vitest": "^3.2.6",
      "@vitest/coverage-v8": "^3.2.6",
      "js-yaml@^3": "^3.15.1",
      "js-yaml@^4": "^4.3.1",
      "sharp": "^0.35.0",
      "adm-zip": "^0.6.0",
      "brace-expansion@^1": "^1.1.17",
      "brace-expansion@^2": "^2.1.3",
      "brace-expansion@^5": "^5.0.8",
      "fast-uri": "^3.1.4",
      "postcss": "^8.5.23"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
